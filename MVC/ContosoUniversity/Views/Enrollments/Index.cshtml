@* @model IEnumerable<ContosoUniversity.Models.Enrollment>*@

 @model PaginatedList<Enrollment>

@{
    ViewData["Title"] = "Index";
}

<h1>Enrollments</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            
            <th>
                Grade
              @*   @Html.DisplayNameFor(model => model.Grade) *@
            </th>
            <th>
               Course
              @*   @Html.DisplayNameFor(model => model.Course) *@
            </th>
            <th>
                Student
               @*  @Html.DisplayNameFor(model => model.Student) *@
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            
            <td>
                @Html.DisplayFor(model => item.Grade)
            </td>
            <td>
                @Html.DisplayFor(model => item.Course.Title)
            </td>
            <td>
                @Html.DisplayFor(model => item.Student.LastName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.EnrollmentID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.EnrollmentID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.EnrollmentID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
@{
    string prevDisabled = Model.HasPreviosPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="paginator-controls">
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Previous
    </a>
    <div>@Model.PageIndex</div>
    <div class="pages">
        @for (int i = 0; i < Model.TotalPages; i++)
        {
            @if (i + 1 == Model.PageIndex)
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page current-page">
                    @(i + 1)
                </a>
            }
            else
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page">
                    @(i + 1)
                </a>

            }
        }


    </div>
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>