@* @model IEnumerable<AcademyVersion2.Models.Direction> *@
    @model PaginatedList<Direction>

@{
    ViewData["Title"] = "Направления и группы";
}
<div class="controls">
    <h1>Направления</h1>
    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по названию:<input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"> </label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>
    <p>
    </p>
    <a asp-action="Create" class="btn btn-primary">Создать</a>
</div>

<div class="paginator">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]" >@Html.DisplayNameFor(model => model.direction_name)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">direction_name</a>
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.Groups)
                </th> *@
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                string selectedRow = "";
                if(item.direction_id==(int?)ViewData["DirectionID"])
                {
                    selectedRow = "table-success";
                }
                <tr class="@selectedRow">
                <td>
                   
                    @Html.DisplayFor(model => item.direction_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Groups)
                </td>
                <td>
                    <a asp-action="Index" asp-route-directionID="@item.direction_id">Select</a> |
                    <a asp-action="Edit" asp-route-id="@item.direction_id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.direction_id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.direction_id">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Prev
    </a>
    <div class="pages">
        @for (int i = 0; i < Model.TotalPages; i++)
        {
            @if (i + 1 == Model.PageIndex)
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page current-page">
                    @(i + 1)
                </a>

            }
            else
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page">
                    @(i + 1)
                </a>

            }

        }
    </div>
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>

<hr class="my-4" />
@if (ViewData["DirectionID"] != null && !string.IsNullOrEmpty((string)ViewData["DirectionName"]))
{
    <h3>Список групп по направлению: @ViewData["DirectionName"]</h3>
    List<AcademyVersion2.Models.Group> groupsList = ViewBag.GroupsForDirection as List<AcademyVersion2.Models.Group>;
    @if (groupsList != null && groupsList.Count > 0)
    {
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Название</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (AcademyVersion2.Models.Group group in groupsList)
                {
                    <tr>
                        <td>@group.group_name</td>
                        
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Для этого направления пока не создано ни одной группы.</p>
    }
}
else
{
    <div class="alert alert-info">
        Выберите направление из списка выше (ссылка "Select"), чтобы увидеть группы этого направления.
    </div>
}