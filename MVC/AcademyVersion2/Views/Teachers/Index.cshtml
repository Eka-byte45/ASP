@model IEnumerable<AcademyVersion2.Models.Teacher>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Учителя</h1>

    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по имени:<input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"> </label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>
    <p>
    </p>
    <a asp-action="Create" class="btn btn-primary">Создать</a>
</div>
<table class="table">
    <thead>
        <tr>
            @* <th>
                @Html.DisplayNameFor(model => model.DisciplinesRelations)
            </th> *@
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.last_name)</a>
               
            </th>
            <th>
                @Html.DisplayNameFor(model => model.first_name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.middle_name)
            </th>
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["DateSortParam"]">@Html.DisplayNameFor(model => model.birth_date)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.email)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.phone)
            </th>
            @*  <th>
                @Html.DisplayNameFor(model => model.photo)
            </th> *@
            <th>
                <a asp-action="Index" asp-route-sortOrder="@ViewData["WorkSinceSortParam"]">@Html.DisplayNameFor(model => model.work_since)</a>
            </th>
            <th>
                @Html.DisplayNameFor(model => model.rate)
            </th>
            @*   <th>
                @Html.DisplayNameFor(model => model.Experience)
            </th> *@
            @* <th>
                @Html.DisplayNameFor(model => model.FullName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Age)
            </th> *@
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                @*  <td>
                @Html.DisplayFor(model => item.DisciplinesRelations)
            </td> *@
                <td>
                    @Html.DisplayFor(model => item.last_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.first_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.middle_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.birth_date)
                </td>
                <td>
                    @Html.DisplayFor(model => item.email)
                </td>
                <td>
                    @Html.DisplayFor(model => item.phone)
                </td>
                @*  <td>
                @Html.DisplayFor(model => item.photo)
            </td> *@
                <td>
                    @Html.DisplayFor(model => item.work_since)
                </td>
                <td>
                    @Html.DisplayFor(model => item.rate)
                </td>
                @* <td>
                @Html.DisplayFor(model => item.FullName)
            </td>
            <td>
                @Html.DisplayFor(model => item.Age)
            </td> *@
                @* <td>
                @Html.DisplayFor(model => item.Experience)
            </td> *@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.teacher_id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.teacher_id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.teacher_id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
