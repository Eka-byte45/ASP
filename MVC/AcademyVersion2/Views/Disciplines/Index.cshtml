@* @model IEnumerable<AcademyVersion2.Models.Discipline> *@
@model PaginatedList<Discipline>

@{
    ViewData["Title"] = "Index";
}

<div class="controls">
    <h1>Дисциплины</h1>
    <form asp-action="Index" method="get">
        <div>
            <label>Поиск по названию:<input type="search" name="SearchString" value="@ViewData["CurrentFilter"]"> </label>
            <input type="submit" value="Найти" class="btn btn-primary" />
            <a asp-action="Index" class="btn btn-secondary">Сброс</a>
        </div>
    </form>
    <p>
    </p>
    <a asp-action="Create" class="btn btn-primary">Создать</a>
</div>
<div class="paginator">
    <table class="table">
        <thead>
            <tr>
                <th>
                    @* <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">@Html.DisplayNameFor(model => model.discipline_name)</a> *@
                    <a asp-action="Index" asp-route-sortOrder="@ViewData["NameSortParam"]">discipline_name</a>
                </th>
                <th>
                    @*  @Html.DisplayNameFor(model => model.number_of_lessons) *@
                    number_of_lesson
                </th>
                @* <th>
                @Html.DisplayNameFor(model => model.TeachersRelations)
                </th> *@
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.discipline_name)
                </td>
                <td>
                    @Html.DisplayFor(model => item.number_of_lessons)
                </td>
                @*  <td>
                @Html.DisplayFor(model => item.TeachersRelations)
                </td> *@
                <td>
                    <a asp-action="Edit" asp-route-id="@item.discipline_id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.discipline_id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.discipline_id">Delete</a>
                </td>
            </tr>
            }
        </tbody>
    </table>
</div>

@{
    string prevDisabled = Model.HasPreviousPage ? "" : "disabled";
    string nextDisabled = Model.HasNextPage ? "" : "disabled";
}

<div class="pagination-controls">
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex - 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @prevDisabled">
        Prev
    </a>
    <div class="pages">
        @for (int i = 0; i < Model.TotalPages; i++)
        {
            @if (i + 1 == Model.PageIndex)
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page current-page">
                    @(i + 1)
                </a>

            }
            else
            {
                <a asp-action="Index" asp-route-pageNumber="@(i+1)" class="page">
                    @(i + 1)
                </a>

            }

        }
    </div>
    <a asp-action="Index"
       asp-route-pageNumber="@(Model.PageIndex + 1)"
       asp-route-currentFilter="@ViewData["CurrentFilter"]"
       class="btn btn-default @nextDisabled">
        Next
    </a>
</div>