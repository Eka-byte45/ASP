@page "/Power"
@rendermode InteractiveServer

<h3>Power</h3>

<div class="power">
    <label>
        a:
        <input type="number" @bind="baseNumber" @bind:after="CalculatePower" />
    </label>
    <label>
        b:
        <input type="number" @bind="exponent" @bind:after="CalculatePower" />
    </label>
    <h3>@baseNumber в степени @exponent = @result </h3>
</div>

<button class="btn btn-primary" @onclick="CalculatePower">Calculate</button>
@code {

}
